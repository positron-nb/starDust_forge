+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the configuration for the application.
+
+    Any keys containing 'SECRET', 'PASSWORD', 'TOKEN', or 'KEY'
+    will be masked with '***'.
+    """
+    import json
+    from flask import current_app
+
+    config = dict(current_app.config)
+    masked_config = {}
+
+    for key, value in config.items():
+        if any(mask_word in key.upper() for mask_word in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            masked_config[key] = "***"
+        else:
+            masked_config[key] = value
+
+    click.echo(json.dumps(masked_config, indent=2, sort_keys=True, default=str))
+
