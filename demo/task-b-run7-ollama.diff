+@app.cli.command()
+def config():
+    """
+    Print loaded application configuration as JSON
+
+    Options:
+      --mask  Mask sensitive values (SECRET, PASSWORD, etc.)
+    """
+    config = current_app.config
+    masked = {}
+    for key, value in config.items():
+        if any(k in key for k in ['SECRET', 'PASSWORD', 'TOKEN', 'KEY']):
+            masked[key] = '***'
+        else:
+            masked[key] = value
+    click.echo(json.dumps(masked, indent=2))
