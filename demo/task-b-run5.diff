+@click.command("config", short_help="Show the app's configuration.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application's configuration.
+
+    Masks the values of any key containing SECRET, PASSWORD, TOKEN or KEY
+    as "***".
+    """
+    import json
+    import re
+
+    mask_re = re.compile(r"SECRET|PASSWORD|TOKEN|KEY")
+    config = {}
+
+    for key, value in current_app.config.items():
+        if mask_re.search(key):
+            config[key] = "***"
+        else:
+            try:
+                json.dumps(value)
+                config[key] = value
+            except (TypeError, ValueError):
+                config[key] = str(value)
+
+    # For debugging purposes
+    # click.echo(f"DEBUG: {current_app.config.get('DEBUG')}", err=True)
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True))
+
+
