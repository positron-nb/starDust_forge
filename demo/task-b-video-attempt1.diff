+class TestConfig:
+    @pytest.fixture
+    def app(self):
+        app = Flask(__name__)
+        app.config.update(
+            {
+                "DEBUG": False,
+                "SECRET_KEY": "secret-value",
+                "DATABASE_PASSWORD": "db-pass",
+                "API_TOKEN": "token-value",
+                "ENCRYPTION_KEY": "key-value",
+                "NORMAL_SETTING": "normal",
+            }
+        )
+        return app
+
+    @pytest.fixture
+    def invoke(self, app, runner):
+        cli = FlaskGroup(create_app=lambda: app)
+        return partial(runner.invoke, cli)
+
+    def test_config_output(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        import json
+        data = json.loads(result.output)
+        assert data["DEBUG"] is False
+        assert data["NORMAL_SETTING"] == "normal"
+        assert data["SECRET_KEY"] == "***"
+        assert data["DATABASE_PASSWORD"] == "***"
+        assert data["API_TOKEN"] == "***"
+        assert data["ENCRYPTION_KEY"] == "***"
+
+    def test_config_sorted_keys(self, invoke):
+        result = invoke(["config"])
+        import json
+        data = json.loads(result.output)
+        keys = list(data.keys())
+        assert keys == sorted(keys)
+
