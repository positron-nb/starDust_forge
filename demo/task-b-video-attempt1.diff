+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application configuration.
+
+    Values for keys containing SECRET, PASSWORD, TOKEN, or KEY are masked.
+    """
+    import json
+
+    config = current_app.config
+    masked_config = {}
+    sensitive_keywords = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+    for key, value in config.items():
+        if any(keyword in key.upper() for keyword in sensitive_keywords):
+            masked_config[key] = "***"
+        else:
+            masked_config[key] = value
+
+    click.echo(json.dumps(masked_config, indent=2, default=str, sort_keys=True))
+
+
+# Add it to the app's own CLI so it's available in tests.
+# Flask.cli.add_command(config_command)
+
