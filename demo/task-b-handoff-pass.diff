+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config for the app as JSON."""
+    import json
+
+    mask_keys = {"SECRET", "PASSWORD", "TOKEN", "KEY"}
+    config = {
+        k: "***" if any(m in k.upper() for m in mask_keys) else v
+        for k, v in current_app.config.items()
+    }
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=repr))
 
