+def test_config_command(runner):
+    def create_app():
+        app = Flask("testapp")
+        app.config["SECRET_KEY"] = "super-secret"
+        app.config["DATABASE_URL"] = "postgresql://user:password@localhost/db"
+        app.config["DEBUG"] = "true"
+        return app
+
+    cli = FlaskGroup(create_app=create_app)
+    result = runner.invoke(cli, ["config"])
+    assert result.exit_code == 0
+    import json
+    output = json.loads(result.output)
+
+    assert output["DATABASE_URL"] == "postgresql://user:password@localhost/db"
+    assert output["SECRET_KEY"] == "***"
+    # Flask's config might normalize DEBUG as boolean
+    assert output["DEBUG"] is False
+
