+@click.command("config", short_help="Show the config values.")
+@with_appcontext
+def config_command() -> None:
+    """Show all configuration values. Sensitive values are masked."""
+    d = dict(current_app.config)
+
+    for key in d:
+        if any(i in key.upper() for i in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            d[key] = "***"
+
+    click.echo(json.dumps(d, indent=2, sort_keys=True, default=str))
+
