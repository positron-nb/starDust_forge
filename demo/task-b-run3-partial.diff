+@click.command("config", short_help="Show the config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config as JSON.
+
+    Values for any key containing SECRET, PASSWORD, TOKEN or KEY are masked
+    as '***'.
+    """
+    import json
+    
+    def _json_encoder(obj: t.Any) -> t.Any:
+        if hasattr(obj, "isoformat"):
+            return obj.isoformat()
+        return str(obj)
+
+    out = {
+        k: "***" if any(x in k for x in ("SECRET", "PASSWORD", "TOKEN", "KEY")) else v
+        for k, v in current_app.config.items()
+    }
+    click.echo(json.dumps(out, indent=2, sort_keys=True, default=_json_encoder))
+
+
