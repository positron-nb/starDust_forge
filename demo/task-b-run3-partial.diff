+def test_config_command():
+    from flask import Flask
+    from flask.cli import ScriptInfo
+    app = Flask("test")
+    app.config["SECRET_KEY"] = "secret"
+    app.config["PASSWORD"] = "password"
+    app.config["DATABASE_URL"] = "sqlite:///:memory:"
+    app.config["TOKEN"] = "token"
+    app.config["TEST_KEY"] = "value"
+    
+    from flask.cli import cli
+    runner = app.test_cli_runner()
+    # The runner needs to be told to use this app.
+    # Actually, ScriptInfo is what `flask` uses to load the app.
+    result = runner.invoke(cli, args=["config"], obj=ScriptInfo(create_app=lambda: app))
+    assert result.exit_code == 0
+    assert '"SECRET_KEY": "***"' in result.output
+    assert '"PASSWORD": "***"' in result.output
+    assert '"DATABASE_URL": "sqlite:///:memory:"' in result.output
+    assert '"TOKEN": "***"' in result.output
+    assert '"TEST_KEY": "value"' in result.output
+
+
