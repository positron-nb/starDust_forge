+@click.command("config", short_help="Show the config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config."""
+    import json
+
+    config = {k: v for k, v in current_app.config.items()}
+    mask_keys = {"SECRET", "PASSWORD", "TOKEN", "KEY"}
+
+    for key, value in config.items():
+        if any(mask in key.upper() for mask in mask_keys):
+            config[key] = "***"
+        elif not isinstance(value, (str, int, float, bool, type(None), list, dict)):
+            config[key] = str(value)
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True))
 
