+def test_config_command(app):
+    app.config["SECRET_KEY"] = "super-secret"
+    app.config["DATABASE_PASSWORD"] = "secret-pass"
+    app.config["API_TOKEN"] = "token-val"
+    app.config["SESSION_KEY"] = "key-val"
+    app.config["TESTING"] = True
+
+    runner = app.test_cli_runner()
+    result = runner.invoke(args=["config"])
+    assert result.exit_code == 0
+    import json
+    data = json.loads(result.output)
+    assert data["SECRET_KEY"] == "***"
+    assert data["DATABASE_PASSWORD"] == "***"
+    assert data["API_TOKEN"] == "***"
+    assert data["SESSION_KEY"] == "***"
+    assert data["TESTING"] is True
