{
  "name": "forge-agent",
  "displayName": "Forge Agent (TrueForge coding agent)",
  "description": "Editor-native coding agent whose loop runs on TrueForge.",
  "version": "0.1.0",
  "publisher": "forgeathon",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge Agent",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "type": "webview",
          "id": "forge.agentView",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "Forge: Inline Edit Selection"
      },
      {
        "command": "forge.cancel",
        "title": "Forge: Cancel Agent Run"
      },
      {
        "command": "forge.newSession",
        "title": "Forge: New Session"
      },
      {
        "command": "forge.showSession",
        "title": "Forge: Open TrueForge Session"
      },
      {
        "command": "forge.undoLast",
        "title": "Forge: Undo Last Applied Change"
      },
      {
        "command": "forge.undoRun",
        "title": "Forge: Undo Agent Run"
      },
      {
        "command": "forge.review.acceptHunk",
        "title": "Forge: Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "forge.review.rejectHunk",
        "title": "Forge: Reject Hunk",
        "icon": "$(close)"
      },
      {
        "command": "forge.review.acceptAll",
        "title": "Forge: Accept All Hunks",
        "icon": "$(check-all)"
      },
      {
        "command": "forge.review.rejectAll",
        "title": "Forge: Reject All Hunks",
        "icon": "$(clear-all)"
      },
      {
        "command": "forge.review.apply",
        "title": "Forge: Apply Review Decisions",
        "icon": "$(pass-filled)"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "forge.cancel",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "forge.review.acceptHunk",
        "key": "alt+y",
        "when": "resourceScheme == forge-review"
      },
      {
        "command": "forge.review.rejectHunk",
        "key": "alt+n",
        "when": "resourceScheme == forge-review"
      },
      {
        "command": "forge.review.apply",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "resourceScheme == forge-review"
      }
    ],
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server URL."
        },
        "forge.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-3-5-flash",
            "google-gemini/gemini-3-1-flash-lite"
          ],
          "description": "Model FQNs configured in TrueForge, in fallback order. The first is primary; on a model error the next one takes over automatically."
        },
        "forge.mcpServerName": {
          "type": "string",
          "default": "forge-workspace",
          "description": "Name under which the editor's MCP server is registered in TrueForge."
        },
        "forge.autoApproveCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^(python -m )?pytest(\\s|$)",
            "^flask( --app \\S+)? (--help|routes|config)\b",
            "^git (status|diff|log)\b"
          ],
          "description": "Regexes for commands the agent may run without a confirmation prompt (TrueForge still pauses; the extension approves). Everything else asks."
        },
        "forge.profile": {
          "type": "string",
          "enum": [
            "full",
            "lean"
          ],
          "default": "full",
          "markdownDescription": "`full`: deferred tool loading, sub-agents and ask-user questions (shows TrueForge features). `lean`: all workspace tools preloaded, no sub-agents or ask-user — ~1.3k fewer prompt tokens per request and no tool-discovery calls; best for small/free models."
        },
        "forge.compactAtTokens": {
          "type": "number",
          "default": 0,
          "markdownDescription": "TrueForge compaction trigger in estimated input tokens (0 = TrueForge default: 80% of the model context). Set e.g. 12000 for free tiers with per-minute token limits."
        },
        "forge.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "markdownDescription": "Reasoning effort sent to the model through TrueForge (`params.reasoning_effort`). `none` turns off thinking on local Ollama models so output-token limits are spent on tool calls. Empty = provider default."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "forge.review.acceptHunk",
          "when": "resourceScheme == forge-review",
          "group": "navigation@1"
        },
        {
          "command": "forge.review.rejectHunk",
          "when": "resourceScheme == forge-review",
          "group": "navigation@2"
        },
        {
          "command": "forge.review.acceptAll",
          "when": "resourceScheme == forge-review",
          "group": "navigation@3"
        },
        {
          "command": "forge.review.rejectAll",
          "when": "resourceScheme == forge-review",
          "group": "navigation@4"
        },
        {
          "command": "forge.review.apply",
          "when": "resourceScheme == forge-review",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "forge.inlineEdit",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.review.acceptHunk",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.review.rejectHunk",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.review.acceptAll",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.review.rejectAll",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.review.apply",
          "when": "resourceScheme == forge-review"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:scripts",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --sourcemap",
    "build:scripts": "esbuild scripts/e2e-edit.ts scripts/e2e-tools.ts scripts/ctx.ts scripts/smoke.ts scripts/ping.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outdir=out"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "^8.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
