+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the app's configuration, masking sensitive values.
+
+    Keys containing SECRET, PASSWORD, TOKEN, or KEY (case-insensitive)
+    will have their values masked as "***".
+    """
+    import re
+
+    mask_pattern = re.compile(r"SECRET|PASSWORD|TOKEN|KEY", re.IGNORECASE)
+    config = {}
+    for key, value in sorted(current_app.config.items()):
+        if mask_pattern.search(key):
+            config[key] = "***"
+        else:
+            config[key] = value
+
+    def json_default(o: t.Any) -> str:
+        # Only convert non-JSON-native types to string
+        return str(o)
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=json_default))
+
+
