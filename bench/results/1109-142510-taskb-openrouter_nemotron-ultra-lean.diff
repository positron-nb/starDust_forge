+class TestConfig:
+    @pytest.fixture
+    def app(self):
+        app = Flask(__name__)
+        app.config.update(
+            {
+                "CUSTOM_DEBUG": True,
+                "SECRET_KEY": "super-secret",
+                "DATABASE_PASSWORD": "db-pass",
+                "API_TOKEN": "api-token",
+                "ENCRYPTION_KEY": "enc-key",
+                "NORMAL_SETTING": "value",
+                "ANOTHER_KEY": "should-be-masked",
+            }
+        )
+        return app
+
+    @pytest.fixture
+    def invoke(self, app, runner):
+        cli = FlaskGroup(create_app=lambda: app, set_debug_flag=False)
+        return partial(runner.invoke, cli)
+
+    def test_config_output(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        import json
+
+        config = json.loads(result.output)
+        # Check masked values
+        assert config["SECRET_KEY"] == "***"
+        assert config["DATABASE_PASSWORD"] == "***"
+        assert config["API_TOKEN"] == "***"
+        assert config["ENCRYPTION_KEY"] == "***"
+        assert config["ANOTHER_KEY"] == "***"
+        # Check unmasked values
+        assert config["CUSTOM_DEBUG"] is True
+        assert config["NORMAL_SETTING"] == "value"
+
+    def test_config_sorted_keys(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        import json
+
+        config = json.loads(result.output)
+        keys = list(config.keys())
+        assert keys == sorted(keys)
+
+    def test_config_pretty_printed(self, invoke):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        # Should be pretty printed with indentation
+        assert "  " in result.output
+        # Should be valid JSON
+        import json
+
+        json.loads(result.output)
+
+
