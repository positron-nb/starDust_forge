+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application configuration.
+
+    Configuration values containing SECRET, PASSWORD, TOKEN, or KEY
+    are masked as "***" for security.
+    """
+    config = current_app.config
+    masked = {}
+    sensitive_patterns = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+    for key, value in sorted(config.items()):
+        if any(pattern in key.upper() for pattern in sensitive_patterns):
+            masked[key] = "***"
+        else:
+            masked[key] = value
+
+    click.echo(json.dumps(masked, indent=2, default=str))
+
