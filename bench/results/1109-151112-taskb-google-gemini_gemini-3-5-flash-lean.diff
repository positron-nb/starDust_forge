+def test_config_command(app):
+    """Test the config command masks sensitive keys."""
+    app.config["SECRET_KEY"] = "secret"
+    app.config["PASSWORD_1"] = "password"
+    app.config["API_TOKEN"] = "token"
+    app.config["MY_KEY"] = "key"
+    app.config["FOO"] = "bar"
+    app.config["DB_URI"] = "postgres://..."
+
+    runner = app.test_cli_runner()
+    # The command is added to FlaskGroup. For tests, we must ensure it's on the app.cli.
+    app.cli.add_command(config_command)
+    result = runner.invoke(args=["config"])
+    assert result.exit_code == 0
+    import json
+    data = json.loads(result.output)
+    assert data["SECRET_KEY"] == "***"
+    assert data["PASSWORD_1"] == "***"
+    assert data["API_TOKEN"] == "***"
+    assert data["MY_KEY"] == "***"
+    assert data["FOO"] == "bar"
+    assert data["DB_URI"] == "postgres://..."
