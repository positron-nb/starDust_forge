+@click.command("config", short_help="Show the config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config.
+
+    Any key containing SECRET, PASSWORD, TOKEN or KEY is masked.
+    """
+    import json
+    from flask import current_app
+
+    config = {}
+
+    for key, value in current_app.config.items():
+        if any(mask in key.upper() for mask in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            config[key] = "***"
+        else:
+            config[key] = value
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=str))
+
+
