+def config_command() -> None:
+    """Print the loaded application's configuration as JSON.
+
+    Values of keys containing SECRET, PASSWORD, TOKEN, or KEY
+    are masked as "***".
+    """
+    config = current_app.config
+    masked = {}
+    for key, value in config.items():
+        if any(term in key for term in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            masked[key] = "***"
+        else:
+            masked[key] = value
+    click.echo(json.dumps(masked, indent=2, sort_keys=True))
