+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application's configuration as JSON.
+
+    Sensitive values are masked. A value is considered sensitive if its
+    key contains ``SECRET``, ``PASSWORD``, ``TOKEN``, or ``KEY``.
+    """
+    from flask import current_app
+    import json
+
+    config = current_app.config
+    masked = {}
+    sensitive_keywords = ["SECRET", "PASSWORD", "TOKEN", "KEY"]
+
+    for key, value in config.items():
+        if any(keyword in key.upper() for keyword in sensitive_keywords):
+            masked[key] = "***"
+        else:
+            masked[key] = value
+
+    click.echo(json.dumps(masked, indent=2, sort_keys=True, default=str))
+
+
