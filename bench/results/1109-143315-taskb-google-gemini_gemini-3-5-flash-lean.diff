+@click.command("config", short_help="Show the config.")
+@pass_script_info
+def config_command(info: ScriptInfo) -> None:
+    """Show the config."""
+    app = info.load_app()
+    config = {}
+
+    for key, value in app.config.items():
+        if any(k in key.upper() for k in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            config[key] = "***"
+        else:
+            try:
+                json.dumps(value)
+                config[key] = value
+            except (TypeError, ValueError):
+                config[key] = str(value)
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True))
+
