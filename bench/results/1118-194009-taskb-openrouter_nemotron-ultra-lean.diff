+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application's configuration.
+
+    Configuration values for keys containing SECRET, PASSWORD, TOKEN,
+    or KEY are masked as "***".
+    """
+    config = dict(current_app.config)
+    masked_config = {}
+    sensitive_keywords = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+    for key, value in config.items():
+        if any(keyword in key.upper() for keyword in sensitive_keywords):
+            masked_config[key] = "***"
+        else:
+            masked_config[key] = value
+
+    click.echo(json.dumps(masked_config, indent=2, default=str))
+
+
